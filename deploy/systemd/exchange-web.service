[Unit]
Description=Exchange Next.js Frontend
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/exchange-web/web
EnvironmentFile=/opt/exchange-web/web/.env.production
User=www
Group=www
ExecStart=/usr/bin/node /opt/exchange-web/web/node_modules/.bin/next start -p 3000
Restart=always
RestartSec=5
TimeoutStopSec=30

[Install]
WantedBy=multi-user.target
